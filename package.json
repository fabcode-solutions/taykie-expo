{
  "name": "taykie-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "author": "Taykie",
  "description": "Taykie mobile application",
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:build:production": "eas build --platform ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "lint-type-check": "yarn lint ; yarn type-check",
    "format": "prettier --write --list-different \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "claude:check": "yarn format && yarn lint-type-check",
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@3.6.4 --activate",
    "deploy": "node ./scripts/deploy.js",
    "deploy:submit": "node ./scripts/deploy.js submit",
    "deploy:web": "node ./scripts/deploy.js web",
    "release:major": "node ./scripts/deploy.js release major",
    "release:minor": "node ./scripts/deploy.js release minor",
    "release:patch": "node ./scripts/deploy.js release patch",
    "release:build": "node ./scripts/deploy.js release build"
  },
  "jest": {
    "preset": "jest-expo"
  },
